# Defaults shown. Nothing here is required for the graded MOCK_LLM run.
MOCK_LLM=1
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# After the first download you can point at the local copy and go fully offline:
# EMBED_MODEL=/path/to/all-MiniLM-L6-v2   and   HF_HUB_OFFLINE=1
# Optional real-LLM path (not used for grading):
# MOCK_LLM=0
# OPENAI_API_KEY=...
# REAL_LLM_MODEL=gpt-4o-mini
